#!/usr/bin/env bash
# Pre-push hook: reject any push whose commits contain Chinese characters in
# file content or in the commit message, and refuse to raise the clippy
# warning count.
#
# The clippy half exists because the project's gate was `cargo build` alone:
# clippy's own deny-by-default lints never ran, and one of them turned out to
# be a test whose assertion could not fail (protection.rs). It runs ONLY when
# the push touches Rust files, and it is a BUDGET, not -D warnings: the tree
# carries style debt that a cleanup round is paying down, and the rule that
# keeps it shrinking is "the count may not rise". Lower the number when you
# fix some; never raise it.

ZERO="0000000000000000000000000000000000000000"
CLIPPY_BUDGET=53

# CJK Unified Ideographs, Extension A, Compatibility Ideographs,
# CJK punctuation/symbols, and fullwidth punctuation forms.
PATTERN='[\x{3000}-\x{303F}\x{3400}-\x{4DBF}\x{4E00}-\x{9FFF}\x{F900}-\x{FAFF}\x{FF01}-\x{FF5E}]'

fail() {
    echo "ERROR: $1" >&2
    echo "Push rejected: remove Chinese characters and try again." >&2
    exit 1
}

touches_rust=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Branch deletion: nothing to inspect
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch: only commits not already reachable from other refs
        commits=$(git rev-list "$local_sha" --not --all)
        changed=$(git diff --name-only "$local_sha" --not --all 2>/dev/null)
    else
        commits=$(git rev-list "$remote_sha..$local_sha")
        changed=$(git diff --name-only "$remote_sha..$local_sha")
    fi

    echo "$changed" | grep -q '\.rs$' && touches_rust=1

    for commit in $commits; do
        if git log -1 --format=%B "$commit" | grep -Pq "$PATTERN"; then
            fail "commit $commit: commit message contains Chinese characters"
        fi

        # Search the full tree of the commit; -I skips binary files
        offenders=$(git grep -I -P -l -e "$PATTERN" "$commit" -- . 2>/dev/null)
        if [ -n "$offenders" ]; then
            fail "commit $commit: Chinese characters found in: $(echo "$offenders" | tr '\n' ' ')"
        fi
    done
done

if [ "$touches_rust" = 1 ]; then
    if command -v cargo >/dev/null 2>&1; then
        count=$(cargo clippy --all-targets --offline 2>&1 | grep -cE '^warning: ')
        echo "clippy: $count warning(s), budget $CLIPPY_BUDGET"
        if [ "$count" -gt "$CLIPPY_BUDGET" ]; then
            echo "ERROR: this push raises the clippy warning count ($count > $CLIPPY_BUDGET)." >&2
            echo "Fix the new warning(s), or lower the budget only when you lower the count." >&2
            exit 1
        fi
    else
        echo "clippy: cargo not found, budget check skipped" >&2
    fi
fi

exit 0
