# ============================================================
# Whitelist-style .gitignore
# Default: EVERYTHING is ignored. Only files/directories
# explicitly un-ignored below are tracked.
# To add a new tracked path, append a negation rule here.
# ============================================================

# Ignore everything at all levels
*

# But let git descend into directories
!*/

# --- Repository base files ---
!/.gitignore
!/LICENSE
!/README.md
!/CONTEXT.md

# --- Project directories ---
!/hooks/**
!/docs/**
!/skills/**
!/.github/**
!/config.example.toml
!/docs/adr/**
!/Cargo.toml
!/Cargo.lock
!/src/**
!/front/**
!/deploy/**
!/tests/**

# --- never tracked, even under a whitelisted directory ---
# Python bytecode: deploy/oracle/presign.py is run in place, and a stray
# __pycache__ would otherwise ride in on the deploy/** whitelist.
__pycache__/
*.pyc
